# ---------------------------------------------------------------------------
# Vercel deployment image for the Barangay Management System (Laravel 12).
#
# Vercel has no PHP runtime, so the app is packaged as an OCI container and
# served by FrankenPHP (PHP + Caddy in one binary). Vercel builds this image,
# stores it in the Vercel Container Registry, and runs it as a Function.
#
# Two things Vercel does NOT provide, which this app would otherwise assume:
#   1. A database  -> point DB_URL at an external Postgres (Neon/Supabase).
#   2. A writable disk -> storage/ is writable per-instance but NOT persistent.
#
# Frontend assets are built here because /public/build is git-ignored, so the
# repository checkout alone ships no CSS or JS.
# ---------------------------------------------------------------------------

FROM dunglas/frankenphp:1-php8.4-bookworm AS base

# intl/zip: Laravel baseline + Composer archives.
# pdo_pgsql + pgsql: the Postgres driver (the only DB reachable from Vercel).
# opcache: keeps a booted app fast across requests on the same instance.
RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_pgsql pgsql opcache

WORKDIR /app

# ---------------------------------------------------------------------------
# Stage 1: frontend assets.
# Vite 7 requires Node ^20.19 || >=22.12, so this is the version floor.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY vite.config.js ./
COPY resources ./resources

# Writes public/build (laravel-vite-plugin default output dir).
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: PHP dependencies + app code.
# ---------------------------------------------------------------------------
FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copied before the app so this layer caches independently of source changes.
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .

# public/build is git-ignored, so bring in the assets built in stage 1.
COPY --from=assets /app/public/build ./public/build

# Laravel needs these directories to exist before anything writes to them.
# `config:cache` is deliberately NOT run here: Vercel injects APP_KEY and the
# database credentials at runtime, and a build-time config cache would bake in
# empty values.
RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/app/private/residents \
        storage/app/private/backups \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan event:cache \
    && php artisan view:cache
# Note: route:cache is intentionally skipped. The route table is not the
# bottleneck here, and a stale route cache is a confusing failure to debug.

# ---------------------------------------------------------------------------
# Stage 3: runtime.
# ---------------------------------------------------------------------------
FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile
COPY --chown=www-data:www-data docker/entrypoint.sh /usr/local/bin/entrypoint.sh

# FrankenPHP binds :80, which needs the capability since we drop to www-data.
# Caddy's own data/config dirs must be writable too.
RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy \
    && chmod +x /usr/local/bin/entrypoint.sh

# LOG_CHANNEL=stderr so logs reach Vercel's log stream instead of a log file
# inside a container that will be recycled.
#
# QUEUE_CONNECTION=sync because Vercel has no long-running worker process:
# queued jobs are executed inline during the request instead of sitting at
# "Queued" forever.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    APP_TIMEZONE=Asia/Manila \
    LOG_CHANNEL=stderr \
    SESSION_DRIVER=database \
    CACHE_STORE=database \
    QUEUE_CONNECTION=sync \
    FILESYSTEM_DISK=local

USER www-data

CMD ["/usr/local/bin/entrypoint.sh"]