APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Production-safe default: never ship debug on. For local development only,
# override to true in your own .env (never commit that change).
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Report boundaries, "today", and every printed/CSV timestamp are local.
# UTC would shift the reporting day by eight hours.
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
# Production disk-fill note: `single` is one ever-growing file. On a live host
# prefer rotation with LOG_STACK=daily (keeps LOG_DAILY_DAYS, see the `daily`
# channel in config/logging.php), or ship to stdout with LOG_CHANNEL=stderr.
# Runtime default is unchanged here; set it per-environment in your own `.env`.
# LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Required session cookie keys (see config/session.php). Secure cookies must
# be true on any HTTPS production host, otherwise browsers drop the session.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# SESSION_EXPIRE_ON_CLOSE=false
# Only needed for specific drivers: SESSION_CONNECTION / SESSION_TABLE for
# database, SESSION_STORE for cache-backed drivers (dynamodb, memcached,
# redis). Leave unset unless you changed SESSION_DRIVER.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local default needs no worker: jobs run inline during the request.
# Production with a queue worker may switch to `database` (or `redis`) and
# run `php artisan queue:work`; without a worker, `database` jobs pile up
# unprocessed (e.g. password-reset codes never send).
QUEUE_CONNECTION=sync

# Local default needs no worker or extra tables. Production with a worker may
# switch to `database` (requires the cache tables) or `redis`.
# File-store note: `file` accumulates entries under
# storage/framework/cache/data — `php artisan cache:clear` on each deploy
# (docs/operations/deploy.md section 4) prunes the stale files.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MAIL
#
# Default (no mail server needed): MAIL_MAILER=failover tries SMTP first and
# falls back to writing the email to storage/logs/laravel.log — handy for
# local testing of the reset flow without silently dropping production mail.
# A bare `log` default would swallow real password-reset emails with no error
# shown anywhere, so prefer failover here.
#
# Gmail SMTP setup (for real password-reset emails — set MAIL_MAILER=smtp):
#   1. Enable 2-Step Verification on the Google account that will send mail.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (16 characters — Gmail rejects your normal login password here).
#   3. Fill in the values below. MAIL_FROM_ADDRESS must be the SAME Gmail
#      account as MAIL_USERNAME, or Google rejects the message.
#   4. Restart `php artisan serve` after editing .env.
# -----------------------------------------------------------------------------
MAIL_MAILER=failover
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_ADDRESS="your.address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
