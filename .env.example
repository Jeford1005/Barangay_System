APP_NAME="Barangay Management System"
APP_ENV=local
APP_KEY=
# Production-safe default: never ship debug on. For local development only,
# override to true in your own .env (never commit that change).
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Report boundaries, "today", and every printed/CSV timestamp are local.
# UTC would shift the reporting day by eight hours.
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# Scheduled-downtime notice banner (optional, off when unset). Shown in the
# app layout while the app is still up so users see the banner instead of
# surprise 503/419s once `php artisan down` runs. MAINTENANCE_FROM/TO are
# free-text window bounds shown as "Scheduled <from> to <to>".
# MAINTENANCE_NOTICE="System maintenance on Sunday 10:00 PM – 11:00 PM."
# MAINTENANCE_FROM="Sunday 10:00 PM"
# MAINTENANCE_TO="Sunday 11:00 PM"

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
# Log rotation (PII retention): the shipped default stack is `daily` — one
# file per day, auto-pruned after LOG_DAILY_DAYS (default 14) — so raw
# identifiers in laravel.log cannot accumulate forever. `single` is one
# ever-growing file: use it only for short-lived local debugging, never on
# a live host. On platforms with their own log collector (Vercel, Render,
# Railway) prefer LOG_CHANNEL=stderr instead of any file channel.
# LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Required session cookie keys (see config/session.php). Secure cookies must
# be true on any HTTPS production host, otherwise browsers drop the session.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# SESSION_EXPIRE_ON_CLOSE=false
# Only needed for specific drivers: SESSION_CONNECTION / SESSION_TABLE for
# database, SESSION_STORE for cache-backed drivers (dynamodb, memcached,
# redis). Leave unset unless you changed SESSION_DRIVER.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local default needs no worker: jobs run inline during the request.
# Production with a queue worker may switch to `database` (or `redis`) and
# run `php artisan queue:work`; without a worker, `database` jobs pile up
# unprocessed (e.g. password-reset codes never send).
QUEUE_CONNECTION=sync

# Shared default: the database cache table ships in migrations, so every
# instance (and every fresh clone after migrate) sees the same entries.
# File-store alternative accumulates under storage/framework/cache/data.
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# MAIL
#
# Default (no mail server needed): MAIL_MAILER=failover tries SMTP first and
# falls back to writing the email to storage/logs/laravel.log — handy for
# local testing of the reset flow without silently dropping production mail.
# A bare `log` default would swallow real password-reset emails with no error
# shown anywhere, so prefer failover here.
#
# Gmail SMTP setup (for real password-reset emails — set MAIL_MAILER=smtp):
#   1. Enable 2-Step Verification on the Google account that will send mail.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (16 characters — Gmail rejects your normal login password here).
#   3. Fill in the values below. MAIL_FROM_ADDRESS must be the SAME Gmail
#      account as MAIL_USERNAME, or Google rejects the message.
#   4. Restart `php artisan serve` after editing .env.
# -----------------------------------------------------------------------------
MAIL_MAILER=failover
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-character-app-password
MAIL_FROM_ADDRESS="your.address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# RETENTION (audit rows + backup files)
#
# Audit rows: `php artisan audit:prune-logs` deletes audit_logs rows older
# than this window (default 365 days, minimum 30 — smaller values are
# refused so recent history is never wiped). Suggested schedule (add to
# routes/console.php after owner approval):
#   Schedule::command('audit:prune-logs')->dailyAt('04:00')
#       ->withoutOverlapping()->onOneServer();
# File logs need no prune command: the `daily` log channel above already
# rotates and drops files older than LOG_DAILY_DAYS.
# AUDIT_LOG_RETENTION_DAYS=365
#
# Backup files: BackupService keeps the newest 10 AND drops files older
# than this window (default 90 days, newest file always spared). Count and
# age apply together on every created backup.
# BACKUP_MAX_AGE_DAYS=90
