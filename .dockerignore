# Keep the build context small and, critically, keep secrets out of the image.
.git
.github
.vercel
/docs
/test-results
/tests

# Secrets -- must never enter an image layer.
.env
.env.*
!.env.example
/auth.json

# Dependencies are installed inside the image instead.
/vendor
/node_modules

# Built assets come from the Node stage of Dockerfile.vercel.
/public/build
/public/hot
/public/storage

# Runtime state and local databases.
/database/*.sqlite
/database/*.sqlite-*
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/app/private/*
/bootstrap/cache/*.php

*.log
.DS_Store
Thumbs.db